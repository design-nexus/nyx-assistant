[Unit]
Description=Assistant Aura and Canvas
After=graphical-session.target nyx-assistantd.service
PartOf=graphical-session.target nyx-assistantd.service
# nyx-assistantd starts at login, before Wayland; the overlay needs a display.
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=%h/.local/bin/nyx-assistant-visual
Restart=on-failure
RestartSec=2
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin

[Install]
WantedBy=graphical-session.target
